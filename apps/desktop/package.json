{
  "name": "openclaw-desktop",
  "version": "1.0.9",
  "description": "OpenClaw Desktop App for Cross-Platform Support",
  "type": "module",
  "main": "./out/main/index.cjs",
  "author": "OpenClaw",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.ts,.jsx,.tsx",
    "typecheck:node": "tsc --p tsconfig.node.json --noEmit",
    "typecheck:web": "tsc --p tsconfig.web.json --noEmit",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "node scripts/prepare-assets.cjs && vite build -c vite.gateway.config.ts && node scripts/copy-docs-to-out.cjs && electron-vite dev",
    "build": "node scripts/prepare-assets.cjs && vite build -c vite.gateway.config.ts && node scripts/copy-docs-to-out.cjs && electron-vite build",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win"
  },
  "build": {
    "appId": "com.openclaw.desktop",
    "productName": "OpenClaw",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.png",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "runAfterFinish": true
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "extensions/**/*",
      "control-ui/**/*",
      "src/**/*",
      "package.json",
      {
        "from": "../../node_modules/.pnpm/better-sqlite3@12.6.2/node_modules/better-sqlite3",
        "to": "node_modules/better-sqlite3"
      },
      {
        "from": "../../node_modules/.pnpm/node-llama-cpp@3.15.0_typescript@5.9.3/node_modules/node-llama-cpp",
        "to": "node_modules/node-llama-cpp"
      },
      {
        "from": "../../node_modules/.pnpm/@napi-rs+canvas@0.1.88/node_modules/@napi-rs/canvas",
        "to": "node_modules/@napi-rs/canvas"
      },
      {
        "from": "../../node_modules/.pnpm/@napi-rs+canvas-win32-x64-msvc@0.1.88/node_modules/@napi-rs/canvas-win32-x64-msvc",
        "to": "node_modules/@napi-rs/canvas-win32-x64-msvc"
      },
      {
        "from": "../../node_modules/.pnpm/sharp@0.34.5/node_modules/sharp",
        "to": "node_modules/sharp"
      },
      {
        "from": "../../node_modules/.pnpm/sqlite-vec@0.1.7-alpha.2/node_modules/sqlite-vec",
        "to": "node_modules/sqlite-vec"
      },
      {
        "from": "../../node_modules/.pnpm/@lydell+node-pty@1.2.0-beta.3/node_modules/@lydell/node-pty",
        "to": "node_modules/@lydell/node-pty"
      },
      {
        "from": "../../node_modules/.pnpm/qrcode-terminal@0.12.0/node_modules/qrcode-terminal",
        "to": "node_modules/qrcode-terminal"
      },
      {
        "from": "../../node_modules/.pnpm/@mariozechner+clipboard@0.3.0/node_modules/@mariozechner/clipboard",
        "to": "node_modules/@mariozechner/clipboard"
      },
      {
        "from": "../../node_modules/.pnpm/@mariozechner+clipboard-win32-x64-msvc@0.3.0/node_modules/@mariozechner/clipboard-win32-x64-msvc",
        "to": "node_modules/@mariozechner/clipboard-win32-x64-msvc"
      },
      {
        "from": "../../node_modules/.pnpm/jiti@2.6.1/node_modules/jiti",
        "to": "node_modules/jiti"
      },
      {
        "from": "../../node_modules/.pnpm/@sinclair+typebox@0.34.47/node_modules/@sinclair/typebox",
        "to": "node_modules/@sinclair/typebox"
      },
      "!**/apps/desktop/dist/**",
      "!**/apps/desktop/out/**",
      "!**/apps/desktop/.electron-vite/**"
    ],
    "asar": true,
    "asarUnpack": [
      "**/better-sqlite3/**",
      "**/@napi-rs/canvas-win32-x64-msvc/**",
      "**/@mariozechner/clipboard-win32-x64-msvc/**"
    ]
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@clack/core": "^0.3.4",
    "@clack/prompts": "^0.11.0",
    "sisteransi": "^1.0.5",
    "picocolors": "^1.1.1",
    "chalk": "^5.3.0",
    "qrcode-terminal": "^0.12.0",
    "node-llama-cpp": "3.15.0",
    "@napi-rs/canvas": "^0.1.88",
    "@lydell/node-pty": "1.2.0-beta.3",
    "better-sqlite3": "^12.6.2",
    "sharp": "^0.34.5",
    "sqlite-vec": "0.1.7-alpha.2",
    "jiti": "^2.6.1",
    "@sinclair/typebox": "0.34.47",
    "@mariozechner/pi-agent-core": "0.49.3",
    "@mariozechner/pi-coding-agent": "0.49.3",
    "zod": "4.3.6",
    "ws": "^8.19.0",
    "commander": "^14.0.2"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "^34.2.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.1.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.8"
  }
}
